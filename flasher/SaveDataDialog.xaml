<Window x:Class="TamaPoke.Flasher.SaveDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="저장 데이터 확인"
        Width="520" Height="310" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#08111F" Foreground="#F4F7FB"
        Icon="assets/TamaPoke.ico">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F7FB" />
      <Setter Property="Background" Value="#21324A" />
      <Setter Property="BorderBrush" Value="#3A4E69" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="25">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="기존 타마포케 한글판을 발견했습니다" FontSize="21" FontWeight="Bold" />
    <StackPanel Grid.Row="1" Margin="0,18,0,18">
      <TextBlock x:Name="VersionText" Foreground="#BFD7EE" FontSize="14" />
      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="22"
                 Text="저장 데이터를 유지하면 PC에 안전하게 백업한 뒤 기기를 초기화하고, 새 펌웨어 설치가 끝난 후 다시 복원합니다." />
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFB2A8" FontSize="13"
                 Text="삭제를 선택하면 현재 포켓몬과 도감, 아이템, 설정이 모두 사라집니다." />
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="백업 후 유지" Background="#23704E" BorderBrush="#45A979"
              Click="KeepButton_Click" />
      <Button Grid.Column="1" Content="삭제 후 새로 설치" Background="#873A3A" BorderBrush="#C36161"
              Click="DeleteButton_Click" />
      <Button Grid.Column="2" Content="취소" Click="CancelButton_Click" />
    </Grid>
  </Grid>
</Window>
