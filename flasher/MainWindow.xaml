<Window x:Class="TamaPoke.Flasher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="타마포케 한글판 플래싱 도구"
        Width="800" Height="730" MinWidth="720" MinHeight="670"
        WindowStartupLocation="CenterScreen"
        Background="#08111F" Foreground="#F4F7FB"
        Icon="assets/TamaPoke.ico"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#101C2E" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A3C55" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A4B2C6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5A49" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F4F7FB" />
      <Setter Property="Background" Value="#21324A" />
      <Setter Property="BorderBrush" Value="#3A4E69" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#304665" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#E94F3D" />
      <Setter Property="BorderBrush" Value="#FF7565" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="24,13" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Malgun Gothic" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="#F4F7FB" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="BorderBrush" Value="#52657D" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0D192A" BorderBrush="#283A53" BorderThickness="0,0,0,1">
      <StackPanel>
        <Border Background="#F6D365" Padding="12,8">
          <TextBlock Text="ESP32-S3 기기의 화면이 켜진 상태로 PC와 연결하세요."
                     Foreground="#111827" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
        </Border>
      <Grid Margin="28,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="64" Height="64" CornerRadius="15" Background="#F4F7FB" Padding="7">
          <Image Source="assets/TamaPoke.ico" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Margin="18,2,0,0">
          <TextBlock Text="타마포케 한글판 플래싱 도구" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="본 프로젝트는 비공식 팬 프로젝트이며 The Pokémon Company, Nintendo, Creatures, GAME FREAK 및 Bandai와 무관합니다. 관련 지식재산권은 각 원저작권자에게 있습니다."
                     Margin="0,7,14,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="2" VerticalAlignment="Top" Background="#223A4F" CornerRadius="9" Padding="11,6">
          <TextBlock Text="배포용" Foreground="#C5E9FF" FontWeight="SemiBold" />
        </Border>
      </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,20,28,18">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="19">
          <StackPanel>
            <StackPanel>
              <TextBlock Text="1. 기기 연결" FontSize="17" FontWeight="Bold" />
              <TextBlock x:Name="ConnectionStatusText" Text="USB-C 데이터 케이블로 기기를 연결해 주세요."
                         Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Margin="0,15,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="DeviceComboBox" DisplayMemberPath="DisplayName"
                        SelectionChanged="DeviceComboBox_SelectionChanged" />
              <Button Grid.Column="1" x:Name="RefreshButton" Content="다시 찾기" Margin="10,0,0,0"
                      Click="RefreshButton_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,13,0,0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="2. 기종 선택" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="자동 선택은 실제 플래시 용량을 읽어 16MB와 32MB 모델을 구분합니다."
                         Foreground="{StaticResource MutedBrush}" Margin="0,6,20,0" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="BoardComboBox" Width="230" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Margin="0,13,0,0" Background="#17273A" BorderBrush="#38516D"
                BorderThickness="1" CornerRadius="14" Padding="17">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="사용자 추가 자산" Foreground="#C5E9FF" FontSize="15" FontWeight="Bold" />
              <TextBlock x:Name="AssetStatusText" Text="추가 자산 ZIP을 확인하고 있습니다."
                         Foreground="#D8E8F6" Margin="0,5,12,0" TextWrapping="Wrap" />
              <TextBlock Text="포켓몬 스프라이트는 설치할 때 원본 저장소에서 자동으로 준비하며 이후에는 캐시를 재사용합니다."
                         Foreground="#A4B2C6" Margin="0,4,12,0" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshAssetsButton" Content="새로고침"
                    VerticalAlignment="Center" Click="RefreshAssetsButton_Click" />
          </Grid>
        </Border>

        <Border Margin="0,13,0,0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="19">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock x:Name="StageText" Text="설치 준비" FontSize="17" FontWeight="Bold" />
                <TextBlock x:Name="DetailText" Text="기기를 선택하고 설치를 시작하세요."
                           Foreground="{StaticResource MutedBrush}" Margin="0,6,40,0" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Top"
                         FontSize="18" FontWeight="Bold" Foreground="#FF8A7D" />
            </Grid>
            <ProgressBar x:Name="InstallProgress" Height="12" Minimum="0" Maximum="100" Value="0"
                         Margin="0,15,0,0" Foreground="{StaticResource AccentBrush}" Background="#07101D" />
          </StackPanel>
        </Border>

        <Grid Margin="0,13,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="자동 확인 후 설치"
                  Click="StartButton_Click" />
          <Button Grid.Column="1" x:Name="CancelButton" Content="취소" Margin="10,0,0,0"
                  IsEnabled="False" Click="CancelButton_Click" />
        </Grid>

        <Expander x:Name="LogExpander" Header="상세 로그" Margin="0,14,0,0" Foreground="#BCCAE0">
          <TextBox x:Name="LogTextBox" Height="145" Margin="0,9,0,0" IsReadOnly="True"
                   FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Background="#050B13" Foreground="#B9C7D9" BorderBrush="#283A53" Padding="10" />
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#0D192A" BorderBrush="#283A53" BorderThickness="0,1,0,0" Padding="28,10">
      <TextBlock Text="설치 중에는 USB 케이블을 분리하거나 PC를 종료하지 마세요."
                 Foreground="{StaticResource MutedBrush}" FontSize="12" />
    </Border>
  </Grid>
</Window>
